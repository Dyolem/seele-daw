{
  "name": "@seele-daw/audio-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#internal/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./development/audio-quality-aq0": "./src/development/audio-quality-aq0.ts",
    "./development/sample-instrument-audition": "./src/development/sample-instrument-audition.ts"
  },
  "scripts": {
    "format": "pnpm --workspace-root format",
    "format:check": "pnpm --workspace-root format:check",
    "lint": "pnpm --workspace-root lint",
    "lint:fix": "pnpm --workspace-root lint:fix",
    "measure:studio-grand-local": "jiti scripts/measure-studio-grand-local-assets.ts",
    "prepare:studio-grand-local": "jiti scripts/prepare-studio-grand-local-assets.ts",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test:run": "vitest run --environment node"
  },
  "dependencies": {
    "@seele-daw/playback": "workspace:*",
    "fflate": "0.8.3"
  }
}
